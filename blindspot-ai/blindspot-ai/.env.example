# Copy to .env and fill in ONE provider. Never commit .env.

# Option 1: Anthropic (default)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Option 2: OpenAI or any OpenAI-compatible API (Groq, OpenRouter, Gemini...)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: force a provider when both keys are set (anthropic | openai)
# LLM_PROVIDER=anthropic
